# pnpm usa un node_modules estricto: cada paquete solo ve lo que declara. Es lo
# que queremos, porque saca a la luz las dependencias fantasma que el hoisting de
# npm tapaba (así apareció que faltaba declarar workbox-window).

# Falla en vez de instalar en silencio si el lockfile no cuadra con package.json.
# CI ya lo hace por defecto; esto lo extiende al entorno local.
prefer-frozen-lockfile=true

# Los avisos de peer dependencies no deben romper la instalación.
strict-peer-dependencies=false
