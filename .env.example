# All optional. PullPilot runs with these defaults and asks for a username and a password
# in the browser on first run. See the README for what each one does.

# STACKS_PATH=/srv/docker-stacks              # one subfolder per project, each with a compose file
# PULLPILOT_PORT=8000
# TZ=Europe/Madrid
# PUBLIC_URL=https://pullpilot.example.com    # only behind a reverse proxy
