# 1) Stacks path — only if you do NOT use /srv/docker-stacks
# DOCKER_ROOT_PATH=/home/user/my_projects

# 2) Port and timezone (optional)
# PULLPILOT_PORT=8000
# TZ=Europe/Madrid

# 3) Auth — nothing to configure. On first run PullPilot asks for a username and a
#    password in the browser and stores them hashed (scrypt) in its database. The
#    session secret is generated and persisted automatically in $DATA_DIR.
#    Forgot the password? See "Password recovery" in the README.
#
# Legacy, optional: only seeds the very first run. Once credentials exist in the
# database these are ignored and PullPilot logs a reminder to remove them.
# AUTH_USER=admin
# AUTH_PASS=your-secure-password
#
# Only define this if you want to control the signing key yourself; otherwise it is
# created at $DATA_DIR/session_secret.key with mode 0600.
# SESSION_SECRET=   # openssl rand -hex 32
#
# Legacy escape hatch: disables authentication entirely AND the setup wizard.
# Isolated networks only.
# ALLOW_NO_AUTH=false

# 4) Other / advanced (see README "Environment variables (reference)")
# DATA_DIR defaults to /app/data; official compose uses pullpilot_data volume.
# DATA_DIR=/app/data
# STATIC_DIR=/app/server/static    # Official image sets this so the SPA is served from the Vite dist (see Dockerfile)
# PROJECTS_ROOT=/path/inside/container  # Different path inside the container than on the host (rare)
# SESSION_HTTPS_ONLY=false
# SESSION_SAME_SITE=lax   # lax | strict | none (none needs HTTPS / Secure cookie)
# CORS_ORIGINS=https://pullpilot.example.com
# HEALTHCHECK_TIMEOUT=60
# COMMAND_TIMEOUT=300
# LOG_LOCALE=es    # Language for scheduled update logs (es | en). UI-triggered updates use browser language.
# LOGIN_RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT_MAX=15
# LOGIN_RATE_LIMIT_WINDOW_SEC=300
# TRUST_X_FORWARDED_FOR=false
